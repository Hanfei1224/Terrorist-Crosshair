{
  "name": "terrorist-crosshair",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Terrorist Crosshair overlay for Windows",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "dev.crosshair.overlay",
    "productName": "Terrorist Crosshair",
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
